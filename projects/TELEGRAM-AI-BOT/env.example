# cp env.example .env
# LLM API keys — fill in only the key(s) for your provider(s)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
XAI_API_KEY=xai-...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
DEEPSEEK_API_KEY=...

# Key rotation: add _2, _3, ... for additional keys of the same provider.
# On RateLimitError the bot cycles through them automatically (notifies via Telegram).
# ANTHROPIC_API_KEY_2=sk-ant-...
# ANTHROPIC_API_KEY_3=sk-ant-...
# OPENAI_API_KEY_2=sk-...

# Fallback model when ALL keys of a provider are rate-limited.
# Set via /settings in Telegram (persisted in current_conversation.json).
# Can also be pre-set here — but /settings takes precedence once saved.
# FALLBACK_MODEL=openai/gpt-4o
