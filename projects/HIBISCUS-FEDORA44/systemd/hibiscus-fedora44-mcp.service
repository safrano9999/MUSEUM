[Unit]
Description=HIBISCUS-FEDORA44 MCP gateway
After=hibiscus-fedora44.service
Wants=hibiscus-fedora44.service
PartOf=hibiscus-fedora44.target

[Service]
Type=simple
User=hibiscus-mcp
Group=hibiscus-mcp
WorkingDirectory=/opt/hibiscus-mcp
Environment=HOME=/var/lib/hibiscus-mcp
Environment=NODE_ENV=production
PassEnvironment=HIBISCUS_STORE_PASSWORD HIBISCUS_MCP_GATEWAY HIBISCUS_FEDORA44_MCP_HOST HIBISCUS_FEDORA44_MCP_PORT HIBISCUS_FEDORA44_MCP_UPSTREAM_URL
ExecStart=/usr/bin/env HIBISCUS_MCP_UPSTREAM_URL=${HIBISCUS_FEDORA44_MCP_UPSTREAM_URL} /usr/bin/node /opt/supergateway/dist/index.js --stdio "/usr/bin/node /opt/hibiscus-mcp/server.mjs" --outputTransport streamableHttp --stateful --host ${HIBISCUS_FEDORA44_MCP_HOST} --port ${HIBISCUS_FEDORA44_MCP_PORT} --streamableHttpPath /mcp --healthEndpoint /healthz --sessionTimeout 3600000 --logLevel info
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=hibiscus-fedora44.target
