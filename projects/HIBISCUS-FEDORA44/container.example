#CONTAINER-NAME
CONTAINER_NAME=hibiscus-fedora44

#default-preset: 8000
HIBISCUS_FEDORA44_MCP_PUBLISH_PORT=8000

#default-preset: hibiscus-fedora44-jameica:/var/lib/hibiscus/.jameica:Z
#required: Persistent Jameica user data
HIBISCUS_FEDORA44_JAMEICA_VOLUMES=hibiscus-fedora44-jameica:/var/lib/hibiscus/.jameica:Z

#default-preset: hibiscus-fedora44-cfg:/usr/local/hibiscus/cfg:Z
#required: Persistent Hibiscus server configuration
HIBISCUS_FEDORA44_CFG_VOLUMES=hibiscus-fedora44-cfg:/usr/local/hibiscus/cfg:Z

#repeat-group: ADDITIONAL_LINE suffix02 ADDITIONAL_LINE
#repeat-freeform: ADDITIONAL_LINE
ADDITIONAL_LINE=
