index 0000000000000000000000000000000000000000..74649da5f87b05acb2f62bb0322a343dc0e8864e
--- /dev/null
+++ b/src/agents/deterministic-gateway-model.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import {
+  DETERMINISTIC_GATEWAY_REPLY,
+  DETERMINISTIC_NOTE_MISSING_REPLY,
+  DETERMINISTIC_NOTE_READY_REPLY,
+  isDeterministicGatewayModel,
+  isDeterministicNoteModel,
+  resolveDeterministicGatewayReply,
+} from "./deterministic-gateway-model.js";
+
+describe("deterministic gateway models", () => {
+  it("recognizes both credential-free model refs case-insensitively", () => {
+    expect(isDeterministicGatewayModel(" DUMMY ", " dummy ")).toBe(true);
+    expect(isDeterministicGatewayModel("dummy", "NOTE")).toBe(true);
+    expect(isDeterministicNoteModel("Dummy", " Note ")).toBe(true);
+    expect(isDeterministicGatewayModel("openai", "dummy")).toBe(false);
+  });
+
+  it("keeps the gateway and NOTE fallbacks deterministic", () => {
+    expect(resolveDeterministicGatewayReply({ provider: "dummy", model: "dummy" })).toBe(
+      DETERMINISTIC_GATEWAY_REPLY,
+    );
+    expect(resolveDeterministicGatewayReply({ provider: "dummy", model: "note" })).toBe(
+      DETERMINISTIC_NOTE_MISSING_REPLY,
+    );
+    expect(
+      resolveDeterministicGatewayReply({
+        provider: "dummy",
+        model: "note",
+        notePluginLoaded: true,
+      }),
+    ).toBe(DETERMINISTIC_NOTE_READY_REPLY);
+  });
+});
diff --git a/src/agents/deterministic-gateway-model.ts b/src/agents/deterministic-gateway-model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f80e1eba7ed71d8299a5efb32326abbce364eb01
--- /dev/null
+++ b/src/agents/deterministic-gateway-model.ts
@@ -0,0 +1,59 @@
+import fs from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const repliesPath = fileURLToPath(new URL("./deterministic-gateway-replies.txt", import.meta.url));
+const gatewayReply = fs.readFileSync(repliesPath, "utf8").trim();
+if (!gatewayReply) {
+  throw new Error("Invalid deterministic replies file: " + repliesPath);
+}
+
+export const DETERMINISTIC_GATEWAY_PROVIDER = "dummy";
+export const DETERMINISTIC_GATEWAY_MODEL = "dummy";
+export const DETERMINISTIC_GATEWAY_MODEL_REF =
+  DETERMINISTIC_GATEWAY_PROVIDER + "/" + DETERMINISTIC_GATEWAY_MODEL;
+export const DETERMINISTIC_NOTE_MODEL = "note";
+export const DETERMINISTIC_NOTE_MODEL_REF =
+  DETERMINISTIC_GATEWAY_PROVIDER + "/" + DETERMINISTIC_NOTE_MODEL;
+export const DETERMINISTIC_GATEWAY_REPLY = gatewayReply;
+export const DETERMINISTIC_NOTE_READY_REPLY = "NOTE ✅";
+export const DETERMINISTIC_NOTE_MISSING_REPLY =
+  "NOTE is not installed. Please install: https://github.com/safrano9999/NOTE/releases/latest/download/note-latest.zip";
+
+function normalizeModelPart(value: string | undefined): string {
+  return value?.trim().toLowerCase() ?? "";
+}
+
+export function isDeterministicGatewayModel(
+  provider: string | undefined,
+  model: string | undefined,
+): boolean {
+  return (
+    normalizeModelPart(provider) === DETERMINISTIC_GATEWAY_PROVIDER &&
+    [DETERMINISTIC_GATEWAY_MODEL, DETERMINISTIC_NOTE_MODEL].includes(normalizeModelPart(model))
+  );
+}
+
+export function isDeterministicNoteModel(
+  provider: string | undefined,
+  model: string | undefined,
+): boolean {
+  return (
+    normalizeModelPart(provider) === DETERMINISTIC_GATEWAY_PROVIDER &&
+    normalizeModelPart(model) === DETERMINISTIC_NOTE_MODEL
+  );
+}
+
+export function resolveDeterministicGatewayReply(params: {
+  provider?: string;
+  model?: string;
+  notePluginLoaded?: boolean;
+}): string | undefined {
+  if (isDeterministicNoteModel(params.provider, params.model)) {
+    return params.notePluginLoaded
+      ? DETERMINISTIC_NOTE_READY_REPLY
+      : DETERMINISTIC_NOTE_MISSING_REPLY;
+  }
+  return isDeterministicGatewayModel(params.provider, params.model)
+    ? DETERMINISTIC_GATEWAY_REPLY
+    : undefined;
+}
