#choices: postgres
#default-preset: postgres
#required: Vikunja database backend
VIKUNJA_DATABASE_TYPE=postgres

#default-preset: host.containers.internal:5432
#required: central PostgreSQL host and port
VIKUNJA_DATABASE_HOST=host.containers.internal:5432

#default-preset: vikunja
#required: PostgreSQL database
VIKUNJA_DATABASE_DATABASE=vikunja

#default-preset: vikunja
#required: PostgreSQL user
VIKUNJA_DATABASE_USER=vikunja

#required: PostgreSQL password
#secret
VIKUNJA_DATABASE_PASSWORD=example: openssl rand -hex 32

#default-preset: disable
#required: PostgreSQL SSL mode
VIKUNJA_DATABASE_SSLMODE=disable

#required: Vikunja signing secret
#secret
VIKUNJA_SERVICE_SECRET=example: openssl rand -hex 32

#default-preset: https://ucore.tailb13f39.ts.net:2105/
#required: externally visible Vikunja URL
VIKUNJA_SERVICE_PUBLICURL=https://ucore.tailb13f39.ts.net:2105/

#choices: true false
#default-preset: false
VIKUNJA_SERVICE_ENABLEREGISTRATION=false
