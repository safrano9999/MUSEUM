# MAILMUSEUM — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# IMAP (offlineimap sync)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Local Maildir
MAILDIR_PATH=

# MariaDB
DB_HOST=localhost
DB_NAME=mailmuseum
DB_USER=
DB_PASSWORD=

# Telegram (Archivist bot)
ARCHIVIST_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_ARCHIVE=
TELEGRAM_HUMAN_USER_ID=
